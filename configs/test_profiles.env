# Test profile knobs for scripts/test_drive.sh
# Anyone cloning the repo can tweak these values without touching Go code.

# QUICK: fast local check (good for every edit)
QUICK_DURATION=3s
QUICK_PRODUCERS=2
QUICK_RATE=1500
QUICK_RUN_RACE=0
QUICK_RUN_CRASH_MATRIX=1
QUICK_CLEAN_STATE=1

# STANDARD: default CI-like local confidence pass
STANDARD_DURATION=8s
STANDARD_PRODUCERS=4
STANDARD_RATE=4000
STANDARD_RUN_RACE=1
STANDARD_RUN_CRASH_MATRIX=1
STANDARD_CLEAN_STATE=1

# HEAVY: stronger manual stress pass
HEAVY_DURATION=20s
HEAVY_PRODUCERS=8
HEAVY_RATE=12000
HEAVY_RUN_RACE=1
HEAVY_RUN_CRASH_MATRIX=1
HEAVY_CLEAN_STATE=1
